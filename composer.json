{
    "name": "platformsh/client",
    "description": "Platform.sh API client",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cocur/slugify": "^3.0",
        "guzzlehttp/guzzle": "^7 || ^8",
        "platformsh/oauth2": "^1.0.0",
        "ext-json": "*",
        "khill/php-duration": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "symplify/easy-coding-standard": "^12.3"
    },
    "autoload": {
        "psr-4": {
            "Platformsh\\Client\\": "src"
        }
    },
    "autoload-dev": {
      "psr-4": {
        "Platformsh\\Client\\Tests\\": "tests"
      }
    },
    "authors": [
        {
            "name": "Patrick Dawkins"
        }
    ],
    "repositories": {
        "platformsh/oauth2": {
            "type": "vcs",
            "url": "https://github.com/kmadejski/platformsh-client-php"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
